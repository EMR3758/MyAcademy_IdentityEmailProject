@model MyAcademy_IdentityEmailProject.Entities.Message
@using System.Globalization
@using System.Net
@using System.Security.Claims
@using System.Text.RegularExpressions
@{
    // MessageController.Detail — erişim (gönderen/alıcı) ve okundu işaretlemesi controller'da yapılır
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name ?? "";
    var isIncoming = string.Equals(Model.ReceiverEmail, userEmail, StringComparison.OrdinalIgnoreCase);
    var isFavorite = ViewBag.IsFavorite is bool b && b;

    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Subject) ? "Mesaj" : Model.Subject;
    ViewData["ActiveMenu"] = isIncoming ? "inbox" : "sent";
    Layout = "~/Views/MessageLayout/Index.cshtml";

    // Gelen mesajda karşı taraf gönderen, giden mesajda alıcıdır
    var contactEmail = isIncoming ? Model.SenderEmail : Model.ReceiverEmail;
    var backAction = isIncoming ? "Inbox" : "SendBox";
    var backText = isIncoming ? "Gelen Kutusu" : "Gönderilenler";
}
@functions {
    static readonly CultureInfo Tr = new("tr-TR");
    static readonly string[] AvatarColors = { "av-lav", "av-blue", "av-mint", "av-rose", "av-peach", "av-sun" };

    static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => p[0])).ToUpper(Tr);
    }

    static string AvatarColor(string? key)
    {
        var h = 0;
        foreach (var c in key ?? "") h = (h * 31 + c) & 0x7fffffff;
        return AvatarColors[h % AvatarColors.Length];
    }

    // Mesaj içeriği editörden HTML olarak gelir. Güvenlik için (XSS) HTML olarak basılmaz;
    // satır/paragraf yapısı korunarak düz metne çevrilir ve Razor tarafından encode edilir.
    static string BodyText(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var text = Regex.Replace(html, @"<\s*br\s*/?>", "\n", RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"</\s*(p|div|li|h[1-6])\s*>", "\n", RegexOptions.IgnoreCase);
        text = Regex.Replace(text, "<[^>]+>", "");
        text = WebUtility.HtmlDecode(text);
        text = Regex.Replace(text, @"\n{3,}", "\n\n");
        return text.Trim();
    }
}

<style>
    .pv-body.as-text { white-space: pre-line; word-break: break-word; }
</style>

<div class="msg-page">

    <div class="mp-top">
        <a class="btn-soft mp-back" asp-controller="Message" asp-action="@backAction">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> <span>@backText</span>
        </a>
    </div>

    <div class="mp-grid">

        <!-- Mesaj -->
        <article class="mp-card" aria-labelledby="mpSubject">
            <div class="pv-subject-row">
                <h1 class="pv-subject" id="mpSubject">@(string.IsNullOrWhiteSpace(Model.Subject) ? "(Konu yok)" : Model.Subject)</h1>

                <form asp-controller="Message" asp-action="ToggleFavorite" method="post">
                    <input type="hidden" name="id" value="@Model.MessageId" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button class="star-btn @(isFavorite ? "on" : "")" type="submit"
                            aria-pressed="@(isFavorite ? "true" : "false")"
                            aria-label="@(isFavorite ? "Yıldızı kaldır" : "Yıldızla")"
                            title="@(isFavorite ? "Yıldızı kaldır" : "Yıldızla")">
                        <i class="bi @(isFavorite ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                    </button>
                </form>
            </div>

            <div class="pv-sender">
                <span class="avatar lg @AvatarColor(Model.SenderEmail)">@Initials(Model.SenderEmail)</span>
                <div class="who">
                    <div class="nm">@Model.SenderEmail</div>
                    <div class="to">Alıcı: <b>@Model.ReceiverEmail</b></div>
                </div>
                <div class="dt">
                    <b>@Model.SendDate.ToString("d MMMM yyyy", Tr)</b>
                    @Model.SendDate.ToString("dddd, HH:mm", Tr)
                </div>
            </div>

            <div class="pv-body as-text">@BodyText(Model.MessageDetail)</div>
        </article>

        <!-- Yan bilgi -->
        <aside class="mp-side">
            <div class="mp-side-card">
                <h6>@(isIncoming ? "Gönderen" : "Alıcı")</h6>
                <div class="mp-contact">
                    <span class="avatar lg @AvatarColor(contactEmail)">@Initials(contactEmail)</span>
                    <div style="min-width:0">
                        <div class="em">@contactEmail</div>
                    </div>
                </div>

                <ul class="mp-facts">
                    <li>
                        <span class="k"><i class="bi bi-folder2" aria-hidden="true"></i> Kategori</span>
                        <span class="v">@(Model.Category?.CategoryName ?? "—")</span>
                    </li>
                    <li>
                        <span class="k"><i class="bi bi-calendar3" aria-hidden="true"></i> Tarih</span>
                        <span class="v">@Model.SendDate.ToString("dd.MM.yyyy HH:mm", Tr)</span>
                    </li>
                    <li>
                        <span class="k"><i class="bi bi-envelope-open" aria-hidden="true"></i> Durum</span>
                        <span class="v">@(Model.IsRead ? "Okundu" : "Okunmadı")</span>
                    </li>
                </ul>
            </div>
        </aside>
    </div>
</div>
